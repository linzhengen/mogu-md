{
  "name": "Copy as Markdown for AI",
  "version": "1.0.0",
  "description": "Convert selected HTML (tables, text) to Markdown optimized for AI agents and copy to clipboard.",
  "manifest_version": 3,
  "author": "seion",
  "permissions": [
    "contextMenus",
    "scripting",
    "activeTab",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
